# === JIOAUTIFY INTEGRATION: production API base. ===
# Loaded ONLY by `npm run build` (CRA auto-selects .env.production).
# In production the Sales CRM app is served same-origin under /sales_crm by the STB backend, so its
# API lives at /sales_crm/api/... and uploads at /sales_crm/uploads/... -> use a RELATIVE base (no
# host) so it works on any deployment host. Must NOT point at http://localhost:4000.
REACT_APP_API_BASE=/sales_crm
