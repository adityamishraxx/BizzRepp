# Copy to .env and fill in real values. Do NOT commit .env.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sales_crm
DB_USER=root
DB_PASSWORD=

# App
PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# File uploads (relative to backend/)
UPLOAD_DIR=uploads

# Initial PMO login (created by seed script if the users table is empty)
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_NAME=PMO
SEED_ADMIN_BU=signage

# 'production' = mounted inside the STB backend; enables jioautify sync (user add/edit/disable/delete
# mirrors to the central STB store, module 22). Use 'development' for standalone runs (sync skipped).
NODE_ENV=development
